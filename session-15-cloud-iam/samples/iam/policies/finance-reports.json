{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FinanceReadReports",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::tagus-finance-reports",
        "arn:aws:s3:::tagus-finance-reports/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    }
  ]
}
