{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PortalShowsInvoices",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::tagus-invoices-prod/*"
    },
    {
      "Sid": "PortalListsInvoices",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tagus-invoices-prod"
    }
  ]
}
